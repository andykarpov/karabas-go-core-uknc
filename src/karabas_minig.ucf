NET "TMDS_P<0>"        LOC="C13"    | IOSTANDARD = TMDS_33; # HDMI_D0P
NET "TMDS_P<1>"        LOC="B12"    | IOSTANDARD = TMDS_33; # HDMI_D1P
NET "TMDS_P<2>"        LOC="C11"    | IOSTANDARD = TMDS_33; # HDMI_D2P
NET "TMDS_P<3>"        LOC="B14"    | IOSTANDARD = TMDS_33; # HDMI_CKP


NET "MIDI_TX"          LOC="P5"     | IOSTANDARD = LVCMOS33;

# SPI FLASH
NET "FLASH_CS_N"       LOC="T3"     | IOSTANDARD = LVCMOS33; # /CONF_CS
NET "FLASH_DO"         LOC="P10"    | IOSTANDARD = LVCMOS33; # CONF_IO1
NET "FLASH_DI"         LOC="T10"    | IOSTANDARD = LVCMOS33; # CONF_IO0
NET "FLASH_SCK"        LOC="R11"    | IOSTANDARD = LVCMOS33; # CONF_CLK
NET "FLASH_WP_N"       LOC="N12"    | IOSTANDARD = LVCMOS33; # CONF_IO2
NET "FLASH_HOLD_N"     LOC="P12"    | IOSTANDARD = LVCMOS33; # CONF_IO3

# ------------------------------------------------------------------------------------------------------------
# UKNC (karabas-forge mc0511): PLL VCO 400 MHz. 50 MHz memory / video (clk_ram), /96 CPU 4.17 MHz, /16 host 25 MHz
# (180 degrees), /128 PPU 3.125 MHz, /50 8 MHz (FT812 clock, HDMI); the SDRAM clock 50 MHz +56.25 degrees.
NET "CLK_50MHZ" TNM_NET = "CLK_50MHZ";
TIMESPEC "TS_CLK_50MHZ" = PERIOD "CLK_50MHZ" 20 ns HIGH 50%;
NET "clk_ram" TNM_NET = "TG_RAM";
NET "pll_clk<1>" TNM_NET = "TG_CPU";
NET "pll_clk<3>" TNM_NET = "TG_HOST";
NET "pll_clk<4>" TNM_NET = "TG_PPU";
NET "pll_clk<5>" TNM_NET = "TG_CLK_8";
# the machine crosses CPU / PPU / host through toggles and two flip-flops (tang): bounded paths
TIMESPEC "TS_CPU_HOST" = FROM "TG_CPU" TO "TG_HOST" 15 ns DATAPATHONLY;
TIMESPEC "TS_HOST_CPU" = FROM "TG_HOST" TO "TG_CPU" 15 ns DATAPATHONLY;
TIMESPEC "TS_PPU_HOST" = FROM "TG_PPU" TO "TG_HOST" 15 ns DATAPATHONLY;
TIMESPEC "TS_HOST_PPU" = FROM "TG_HOST" TO "TG_PPU" 15 ns DATAPATHONLY;
# MCU SPI: classic frames and bursts at 16 MHz (BURST_MAX_MHZ 16 of kg_mcu)
NET "MCU_SCK" TNM_NET = "TG_SPI";
TIMESPEC "TS_SPI" = PERIOD "TG_SPI" 62.5 ns HIGH 50%;
NET "MCU_MOSI" OFFSET = IN 16 ns VALID 32 ns BEFORE "MCU_SCK" RISING;
NET "MCU_MISO" OFFSET = OUT 25 ns AFTER "MCU_SCK" FALLING;
TIMESPEC "TS_SPI_HOST" = FROM "TG_SPI" TO "TG_HOST" 31.25 ns DATAPATHONLY;
TIMESPEC "TS_HOST_SPI" = FROM "TG_HOST" TO "TG_SPI" 31.25 ns DATAPATHONLY;
# SDRAM pads: one IOB input register bank (sdram2 of the port)
TIMEGRP "TG_SDR_IN" = PADS("SDR_DQ<*>");
TIMEGRP "TG_SDR_OUT" = "TG_SDR_IN" PADS("SDR_A<*>") PADS("SDR_BA<*>") PADS("SDR_DQM<*>") PADS("SDR_WE_N") PADS("SDR_RAS_N") PADS("SDR_CAS_N");
TIMESPEC "TS_SDR_OUT" = FROM FFS TO "TG_SDR_OUT" 5 ns DATAPATHONLY;
TIMESPEC "TS_SDR_IN" = FROM "TG_SDR_IN" TO FFS 4 ns DATAPATHONLY;
# I2S: DIN / WS launch on the PPU rising edge, the DAC samples on the rising (inverted) BCK 160 ns later
TIMEGRP "TG_DAC_OUT" = PADS("DAC_DAT") PADS("DAC_WS");
TIMESPEC "TS_DAC_OUT" = FROM FFS TO "TG_DAC_OUT" 20 ns DATAPATHONLY;
# ---- frame buffer (uknc_framebuffer): SRAM on clk_ram, the 800 x 600 @ 60 Hz output on clk_vid (40 MHz, PLL2) --
NET "clk_vid" TNM_NET = "TG_VID";
# the read request crosses with a toggle through 3 flip-flops, its line is stable for a whole line before it; the
# line buffers are a two-clock block RAM
TIMESPEC "TS_VID_RAM" = FROM "TG_VID" TO "TG_RAM" 20 ns DATAPATHONLY;
TIMESPEC "TS_RAM_VID" = FROM "TG_RAM" TO "TG_VID" 20 ns DATAPATHONLY;
# the OSD commands of the mcu (host clock) into clk_vid: taken when stable on two clocks
TIMESPEC "TS_HOST_VID" = FROM "TG_HOST" TO "TG_VID" 25 ns DATAPATHONLY;
# the audio of the mixer (PPU clock) into clk_vid: taken when it is stable on two clocks
TIMESPEC "TS_PPU_VID" = FROM "TG_PPU" TO "TG_VID" 25 ns DATAPATHONLY;
# SRAM IS61WV20488 (tAA 10 ns): a read is the address on a clk_ram edge, the data in the IOB register two edges later
# (8 + 10 + 4 ns of 40)
TIMEGRP "TG_SRAM_IN" = PADS("MD<*>");
TIMEGRP "TG_SRAM_OUT" = "TG_SRAM_IN" PADS("MA<*>") PADS("MRD_N<*>") PADS("MWR_N<*>");
TIMESPEC "TS_SRAM_OUT" = FROM FFS TO "TG_SRAM_OUT" 8 ns DATAPATHONLY;
TIMESPEC "TS_SRAM_IN" = FROM "TG_SRAM_IN" TO FFS 4 ns DATAPATHONLY;
# ---- HDMI (kg_hdmi_ft): the pixel clock is clk_vid (the FT812 video is not used, ft_sel 0) -------------------
NET "FT_CLK" TNM_NET = "TG_CLK_FT";
TIMESPEC "TS_CLK_FT" = PERIOD "TG_CLK_FT" 80 MHz HIGH 50%;
NET "hdmi_top/p_clk_int" TNM_NET = "TG_CLK_PIX"; # the output of the BUFGMUX clkpllin
TIMESPEC "TS_VID_TO_PIX" = FROM "TG_VID" TO "TG_CLK_PIX" 25 ns DATAPATHONLY;
